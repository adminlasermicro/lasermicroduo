          "fontFamily": "{font.family.sans}",
          "fontSize": "17px",
          "lineHeight": 1.65,
          "fontWeight": 400,
          "letterSpacing": "0"
        },
        "$description": "All running text. Never smaller for anything a buyer needs to read."
      },
      "body-strong": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "17px",
          "lineHeight": 1.65,
          "fontWeight": 600,
          "letterSpacing": "0"
        },
        "$description": "Inline emphasis, FAQ questions, nav links."
