    "style": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "clamp(2.5rem, 1.6rem + 3.6vw, 4.25rem)",
          "lineHeight": 1.06,
          "fontWeight": 700,
          "letterSpacing": "-0.02em"
        },
        "$description": "Page hero headline (h1). 40px on phones. One per page."
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "clamp(1.875rem, 1.4rem + 1.7vw, 2.75rem)",
