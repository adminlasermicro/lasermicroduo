---
// Meet the owner. Uses Vicki's own words from src/data/about.js once supplied; never invented.
import Media from '../site/Media.astro';
import { MEDIA } from '../../data/media.js';
import { STORY } from '../../data/about.js';
import { SITE } from '../../site.config.js';
---
<section class="section" aria-labelledby="owner-title">
  <div class="container owner">
    <Media item={MEDIA.vicki} />
    <div class="stack">
      <h2 class="h2" id="owner-title">Meet the owner</h2>
      <p class="measure">{SITE.name} is a small {SITE.ownerPlace} business owned by {SITE.owner}. We’re an independent authorized reseller of LaserTouchOne, and real people answer your texts.</p>
      {STORY.length > 0 ? <p class="measure">{STORY[0]}</p> : <p class="measure muted">[NEEDS NOA: 2–3 sentences from Vicki, in her words, with her OK]</p>}
      <p><a href="/about">More about us</a></p>
    </div>
  </div>
</section>
