---
import Media from '../site/Media.astro';
import { MEDIA } from '../../data/media.js';
---
<section class="section" aria-labelledby="demo-title">
  <div class="container split">
    <div class="stack">
      <h2 class="h2" id="demo-title">See the two-minute routine</h2>
      <p class="measure">Watch a full session on the neck and shoulder, start to finish: gel on, switch on, slow circles, done.</p>
    </div>
    <Media item={MEDIA.demo} />
  </div>
</section>
