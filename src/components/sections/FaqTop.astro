---
import FaqList from '../site/FaqList.astro';
import { TOP_FAQS } from '../../data/faq.js';
---
<section class="section section--mist" aria-labelledby="faq-title" data-sticky-stop>
  <div class="container faq-wrap">
    <div class="section-head">
      <h2 class="h2" id="faq-title">Questions people ask first</h2>
      <p><a href="/faq">See all questions</a>, or text us.</p>
    </div>
    <FaqList items={TOP_FAQS} />
  </div>
</section>
