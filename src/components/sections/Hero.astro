---
// Home and landing-page hero: headline inside the indication, the two technologies, the product,
// the price, one Add to cart, and the trust lines directly under the button.
import PriceTag from '../site/PriceTag.astro';
import Assure from '../site/Assure.astro';
import Media from '../site/Media.astro';
import { MEDIA } from '../../data/media.js';
const { kit, headline = 'FDA-cleared relief for minor chronic neck and shoulder pain, at home in about 2 minutes', moreHref = '/how-it-works', moreLabel = 'See how it works' } = Astro.props;
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="h1">{headline}</h1>
      <p class="lead">A handheld, drug-free device that combines a low-level laser and TENS electrical stimulation. Made by Laser Health Technologies in Scottsdale, Arizona.</p>
      <div class="hero__buy">
        {kit.price && <PriceTag kit={kit} />}
        <div class="stack" data-buy-anchor>
          {kit.productId
            ? <button type="button" class="btn btn--primary btn--full" data-add-to-cart={kit.productId} data-track-price={kit.amount} data-variant={kit.variantId ?? ''}>Add to cart</button>
            : <a class="btn btn--primary btn--full" href="/contact">Ask about price</a>}
          <a class="hero__more" href={moreHref}>{moreLabel}</a>
        </div>
        <Assure />
      </div>
    </div>
    <div class="hero__media"><Media item={MEDIA.cutout} eager /></div>
  </div>
</section>
