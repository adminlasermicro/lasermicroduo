---
// Header: announcement bar, logo, five menu items, "Shop now" and the cart. In `bare` mode
// (ad landing pages) it shows only the logo and the text-us line, so nothing leads away.
import Icon from './Icon.astro';
import { SITE, textHref } from '../../site.config.js';
const { bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/shop', label: 'Shop' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/fda-clearance', label: 'FDA clearance' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
];
---
<div class="announce">
  <div class="container announce__in">
    {SITE.announcements.map((a, i) => <span class={i > 0 ? 'announce__extra' : ''}>{a}</span>)}
  </div>
</div>

{bare ? (
  <header class="header" data-header>
    <div class="container header__in">
      <span class="logo"><img class="logo__img" src="/brand/lmd-logo-horizontal.svg" alt="Laser Micro Duo" width="386" height="56" /></span>
      {SITE.textNumber && <a class="header__text-us" href={textHref}><Icon name="message" size={20} /> Text {SITE.textNumber}</a>}
    </div>
  </header>
) : (
  <header class="header" data-header>
    <div class="container header__in">
      <a class="logo" href="/"><img class="logo__img" src="/brand/lmd-logo-horizontal.svg" alt="Laser Micro Duo, home" width="386" height="56" /></a>
      <nav class="nav" aria-label="Main">
        {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      <div class="header__actions">
        <a class="btn btn--primary btn--sm header__shop" href="/shop">Shop now</a>
        <button type="button" class="cart-btn" data-open-cart data-cart-label aria-label="Cart, 0 items">
          <Icon name="bag" size={22} />
          <span class="cart-btn__count" data-cart-count aria-hidden="true">0</span>
        </button>
        <button type="button" class="menu-btn" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
          <Icon name="menu" size={24} />
        </button>
      </div>
    </div>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/contact">Contact</a>
      <a class="btn btn--primary" href="/shop">Shop LaserTouchOne</a>
    </nav>
  </header>
)}
