---
// Main header: logo, five menu items, "Buy now" and the cart. In `bare` mode (ad landing pages)
// it shows only the logo and the text-us line, so nothing leads away from the page.
import Icon from './Icon.astro';
import { SITE, textHref } from '../../site.config.js';
const { bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/shop', label: 'Shop' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/fda-clearance', label: 'FDA clearance' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
];
---
{bare ? (
  <header class="header lp-header">
    <div class="container header__in">
      <span class="logo"><img class="logo__img" src="/brand/lmd-logo-horizontal.svg" alt="Laser Micro Duo" width="386" height="56" /></span>
      {SITE.textNumber && <a class="lp-header__help" href={textHref}>Text {SITE.textNumber}</a>}
    </div>
  </header>
) : (
  <header class="header" data-header>
    <div class="container header__in">
      <a class="logo" href="/"><img class="logo__img" src="/brand/lmd-logo-horizontal.svg" alt="Laser Micro Duo, home" width="386" height="56" /></a>
      <nav class="nav" aria-label="Main">
        {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      <div class="header__actions">
        <a class="btn btn--primary btn--sm header__buy" href="/shop">Buy now</a>
        <button type="button" class="icon-btn" data-open-cart aria-label="Cart, 0 items" data-cart-label>
          <Icon name="bag" size={24} />
          <span class="cart-count" data-cart-count aria-hidden="true">0</span>
        </button>
        <button type="button" class="icon-btn menu-btn" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
          <Icon name="menu" size={24} />
        </button>
      </div>
    </div>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/contact">Contact</a>
      <a class="btn btn--primary btn--full" href="/shop">Buy now</a>
    </nav>
  </header>
)}
