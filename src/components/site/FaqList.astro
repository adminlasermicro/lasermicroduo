---
// Accordion of questions. Answers may contain simple HTML (links).
const { items, openFirst = false } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details open={openFirst && i === 0}>
      <summary>{f.q}</summary>
      <div class="faq__a"><p set:html={f.a} /></div>
    </details>
  ))}
</div>
