---
import Icon from './Icon.astro';
import ProductPhoto from './ProductPhoto.astro';
import PriceTag from './PriceTag.astro';
import { PHOTOS } from '../../data/photos.js';
import { TOP_FAQ_PAGE as TOP_FAQS } from '../../data/faqPage.js';
import FaqList from './FaqList.astro';
import ReviewGrid from './ReviewGrid.astro';
import { REAL_REVIEWS } from '../../data/reviews.js';
import CtaBand from './CtaBand.astro';
import ResellerSeal from './ResellerSeal.astro';
import StickyBuy from './StickyBuy.astro';
import { SITE, textHref } from '../../site.config.js';

// The homepage's sales sections, shared by / and the ad landing pages (/lp/...).
// `lp` drops the parts an ad visitor doesn't need and keeps links on the page.
const { kit, lp = false } = Astro.props;

const trust = [
  { icon: 'shield', label: 'FDA-cleared', sub: '510(k) K100116', href: '/fda-clearance' },
  { icon: 'file', label: 'No prescription needed' },
  { icon: 'leaf', label: 'Drug-free' },
  { icon: 'check', label: 'Authorized reseller' },
  { icon: 'message', label: 'Arizona-based support' },
];
const steps = [
  { icon: 'droplet', title: 'Add a little gel', text: 'A thin layer helps the electrical stimulation reach your skin.' },
  { icon: 'timer', title: 'Glide slowly', text: 'Move the tip in small, slow circles over your neck or shoulder for about 2 minutes.' },
  { icon: 'repeat', title: 'Repeat as needed', text: 'Up to five times a day, at least two to three hours apart.' },
];
const fmt = (n) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
const priceNow = Number.isFinite(kit.amount) ? fmt(kit.amount) : kit.price;
const priceWas = kit.compareAt && Number.isFinite(kit.compareAmount) ? fmt(kit.compareAmount) : null;
const whyBuy = [
  { icon: 'file', text: 'Manufacturer’s warranty' },
  { icon: 'calendar', text: 'Manufacturer’s money-back guarantee' },
  { icon: 'message', text: 'Text support' },
];
---
  <!-- Hero: one full-width photo, text on a soft scrim -->
  <section class="hero-full">
    <img class="hero-full__img" src={PHOTOS.hero.src} srcset={PHOTOS.hero.srcset} sizes="100vw" width={PHOTOS.hero.width} height={PHOTOS.hero.height} alt={PHOTOS.hero.alt} fetchpriority="high" />
    <div class="container hero-full__in">
      <div class="hero-full__copy">
        <h1 class="display">FDA-cleared relief for minor neck and shoulder pain, at home in about 2 minutes.</h1>
        <p class="lead">
          LaserTouchOne pairs a gentle cold laser with mild electrical stimulation in one small handheld.
          Drug-free. No prescription. Use it on the couch, at your desk, or on the go.
        </p>
        {priceNow && (
          <p class="hero-full__price">
            <strong>{priceNow}</strong>{priceWas && <> · <span>Manufacturer list price <s>{priceWas}</s></span></>}
          </p>
        )}
        <div class="hero-full__actions hero-full__actions--stack">
          {kit.productId
            ? <button type="button" class="btn btn--primary btn--lg" data-add-to-cart={kit.productId} data-variant={kit.variantId ?? ''} data-track-price={kit.amount}>Add to cart{priceNow ? ` – ${priceNow}` : ''}</button>
            : <a class="btn btn--primary btn--lg" href="#kits">Shop LaserTouchOne</a>}
          <p class="hero-full__fact">
            <Icon name="shield" size={18} /> Money-back guarantee ·{' '}
            {SITE.textNumber ? <>Text a real person: <a href={textHref}>{SITE.textNumber}</a></> : 'Text a real person'}
          </p>
          <a class="link-arrow" href={lp ? '#how' : '/how-it-works'}>See how it works <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust row -->
  <section class="trust" aria-label="Why buy from us">
    <div class="container">
      <ul class="trust__list">
        {trust.map((t, i) => (
          <li data-reveal style={`--d:${i * 60}ms`}>
            <span class="icon-badge"><Icon name={t.icon} /></span>
            <span>{t.href ? <a class="trust__link" href={t.href}><strong>{t.label}</strong></a> : <strong>{t.label}</strong>}{t.sub && <span class="trust__sub">{t.sub}</span>}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Two technologies -->
  <section class="section" id="how">
    <div class="container split">
      <ProductPhoto file="01_hero-3-4.jpg" />
      <div class="split__copy">
        <h2 class="h2" data-reveal>Two technologies. One small device.</h2>
        <p class="lead" data-reveal style="--d:80ms">
          Most at-home options give you one tool. LaserTouchOne puts two in the same head, working on the
          same spot at the same time.
        </p>
        <div class="feature" data-reveal style="--d:160ms">
          <span class="icon-badge icon-badge--lg"><Icon name="sun" size={24} /></span>
          <div>
            <h3 class="h3">Cold laser</h3>
            <p>A low-power red laser (670 nm). No heat, and nothing to feel.</p>
          </div>
        </div>
        <div class="feature" data-reveal style="--d:220ms">
          <span class="icon-badge icon-badge--lg"><Icon name="zap" size={24} /></span>
          <div>
            <h3 class="h3">Gentle electrical stimulation</h3>
            <p>Two metal contacts beside the laser deliver a soft tingle you control with a dial.</p>
          </div>
        </div>
        <p class="tech-note" data-reveal>FDA-cleared in the over-the-counter TENS category. No pads, no wires.</p>
        {!lp && <a class="link-arrow" href="/how-it-works">Learn how they work together <Icon name="arrow" size={18} /></a>}
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="section band">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" data-reveal>Three steps. About two minutes.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" data-reveal style={`--d:${i * 90}ms`}>
            <span class="step__icon"><Icon name={s.icon} size={28} /><span class="step__num" aria-hidden="true">{i + 1}</span></span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Reviews -->
  {REAL_REVIEWS.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="section-head section-head--row">
        <h2 class="h2">What our customers say</h2>
        <a class="link-arrow" href="/shop#reviews">Read all reviews <Icon name="arrow" size={18} /></a>
      </div>
      <ReviewGrid />
    </div>
  </section>
  )}

  <!-- The kit: open split, no floating card -->
  <section class="section section--tint" id="kits">
    <div class="container offer">
      <ProductPhoto file="08_case-with-device.jpg" class="offer__media" />
      <div class="offer__body">
        <h2 class="h2 offer__name" data-reveal>Everything in one kit</h2>
        <p class="lead" data-reveal style="--d:80ms">{kit.blurb} Made by {SITE.manufacturer} in Scottsdale, Arizona. Every order comes with the manufacturer’s money-back guarantee, the manufacturer’s warranty and support from us.</p>
        <ul class="checklist" data-reveal style="--d:140ms">
          {kit.includes.map((item) => <li><Icon name="check" size={18} />{item}</li>)}
        </ul>
        <div class="offer__foot" data-buy-anchor>
          {kit.price ? <PriceTag kit={kit} /> : <p class="kit__ask">Price on request</p>}
          {kit.productId
            ? <button type="button" class="btn btn--primary btn--lg" data-add-to-cart={kit.productId} data-variant={kit.variantId ?? ''} data-track-price={kit.amount}>Add to cart</button>
            : <a class="btn btn--primary btn--lg" href="/contact">Ask about price</a>}
        </div>
        <ul class="why-buy" aria-label="Why buy from us">
          {whyBuy.map((w) => <li><Icon name={w.icon} size={18} />{w.text}</li>)}
        </ul>
        <p class="kits__note"><Icon name="truck" size={18} /> Flat-rate shipping in the US. International shipping is calculated at checkout.</p>
        <div class="seals"><ResellerSeal /><ResellerSeal kind="fda" /></div>
      </div>
    </div>
  </section>

  {!lp && (<>
  <!-- FDA explained -->
  <section class="section">
    <div class="container split split--reverse">
      <div class="fda-card" data-reveal>
        <span class="icon-badge icon-badge--lg"><Icon name="file" size={24} /></span>
        <dl>
          <div><dt>Clearance</dt><dd>510(k) K100116</dd></div>
          <div><dt>Cleared</dt><dd>April 15, 2010</dd></div>
          <div><dt>Use</dt><dd>Over the counter, no prescription</dd></div>
          <div><dt>Maker</dt><dd>{SITE.manufacturer}, Scottsdale, AZ</dd></div>
          <div><dt>Technology</dt><dd>670 nm low-level laser and TENS (electrical stimulation)</dd></div>
        </dl>
        <a class="link-arrow" href="https://www.accessdata.fda.gov/cdrh_docs/pdf10/K100116.pdf" target="_blank" rel="noopener">Read the FDA document <Icon name="arrow" size={18} /></a>
      </div>
      <div class="split__copy">
        <h2 class="h2" data-reveal>FDA-cleared, explained simply</h2>
        <p class="lead" data-reveal style="--d:80ms">
          “FDA-cleared” means the FDA reviewed LaserTouchOne and cleared it for sale for specific uses.
          For this device, that means:
        </p>
        <ul class="checklist checklist--lg" data-reveal style="--d:140ms">
          <li><Icon name="check" size={20} />Symptomatic relief of chronic, intractable pain</li>
          <li><Icon name="check" size={20} />Adjunctive treatment of acute pain after surgery or an injury, alongside your other care</li>
          <li><Icon name="check" size={20} />Temporary relief of minor chronic neck and shoulder pain of musculoskeletal origin, alongside your other care</li>
        </ul>
      </div>
    </div>
  </section>

  </>)}

  <!-- Guarantee -->
  <section class="section band" aria-labelledby="guarantee-title">
    <div class="container split">
      <div class="split__copy">
        <h2 class="h2" id="guarantee-title">Money-back guarantee, backed by the manufacturer</h2>
        <p class="lead">Every kit is covered by {SITE.manufacturer}’ money-back guarantee. If LaserTouchOne isn’t right for you, you get a full refund of the device price. You pay the return shipping, and the original shipping isn’t refunded.</p>
        <a class="link-arrow" href="/returns">Read the full guarantee <Icon name="arrow" size={18} /></a>
      </div>
      <ol class="steps steps--compact">
        {[
          { icon: 'message', title: 'Text or email us', text: 'Send us your order number and we’ll take it from there.' },
          { icon: 'file', title: 'Get your instructions', text: 'We reply with the return address and what to include.' },
          { icon: 'truck', title: 'Ship the kit back', text: 'Send the full kit with tracking. Return shipping is yours.' },
          { icon: 'wallet', title: 'Get your refund', text: 'We refund the device price to your original payment method.' },
        ].map((s, i) => (
          <li class="step">
            <span class="step__icon"><Icon name={s.icon} size={28} /><span class="step__num" aria-hidden="true">{i + 1}</span></span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--tight-top" data-sticky-stop>
    <div class="container faq-wrap">
      <div class="section-head">
        <h2 class="h2" data-reveal>Questions, answered</h2>
        <p class="lead">Can’t find yours? <a href="/faq">See all questions</a> or text us.</p>
      </div>
      <FaqList items={TOP_FAQS} />
    </div>
  </section>

  <CtaBand />
  <StickyBuy kit={kit} />
