---
// Real customer videos and written testimonials. Renders nothing until real ones are added to
// src/data/voices.js. Every entry needs a disclosure when the person is family, staff or got a free
// or discounted unit, and must stay inside the FDA-cleared uses.
import { VOICES } from '../../data/voices.js';
const { title = 'From people who use it' } = Astro.props;
const list = VOICES.filter((v) => !v.placeholder);
---
{list.length > 0 && (
  <section class="section" aria-labelledby="voices-title">
    <div class="container">
      <div class="section-head"><h2 class="h2" id="voices-title">{title}</h2></div>
      <div class="voices">
        {list.map((v) => (
          <figure class="voice">
            {v.video && <video src={v.video} poster={v.poster} controls preload="none" playsinline width="1080" height="1920"><track kind="captions" src={v.captions} srclang="en" label="English" default /></video>}
            {v.quote && <blockquote><p>“{v.quote}”</p></blockquote>}
            <figcaption><strong>{v.name}</strong>{v.place && <>, {v.place}</>}</figcaption>
            {v.disclosure && <p class="voice__disclosure">{v.disclosure}</p>}
          </figure>
        ))}
      </div>
      <p class="small muted" style="margin-top:var(--s3)">Individual experiences vary. LaserTouchOne is cleared for the uses listed on our FDA clearance page.</p>
    </div>
  </section>
)}
