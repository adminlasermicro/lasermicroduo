---
// Closing band: one buy button and the human contact details.
import PriceTag from './PriceTag.astro';
import { SITE, textHref } from '../../site.config.js';
const { kit, title = 'Ready when you are', text = 'Order LaserTouchOne today, or text us first. A real person will answer your questions.' } = Astro.props;
---
<section class="section cta-final">
  <div class="container cta-final__in">
    <div class="stack">
      <h2 class="h2">{title}</h2>
      <p class="lead" style="max-width:46ch">{text}</p>
      <p>{SITE.textNumber && <>Text <a href={textHref}>{SITE.textNumber}</a> · </>}Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a><br />{SITE.replyHours}</p>
    </div>
    <div class="cta-final__actions">
      {kit?.productId
        ? <button type="button" class="btn btn--primary btn--full" data-add-to-cart={kit.productId} data-track-price={kit.amount} data-variant={kit.variantId ?? ''}>Add to cart{kit.price ? `, ${kit.price.replace('.00', '')}` : ''}</button>
        : <a class="btn btn--primary btn--full" href="/shop">See the kit</a>}
      <a class="btn btn--secondary btn--full" href="/shop">See what’s in the kit</a>
    </div>
  </div>
</section>
