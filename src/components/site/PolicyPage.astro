---
// Shared layout for the policy pages (shipping, returns, privacy, terms).
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHead from './PageHead.astro';
const { title, lead, updated, schema = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const crumbs = [{ label: title }];
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.lasermicroduo.com/' },
  { '@type': 'ListItem', position: 2, name: title, item: `https://www.lasermicroduo.com${path}` },
] };
---
<SiteLayout schema={[breadcrumb, ...schema]}>
  <PageHead title={title} lead={lead} crumbs={crumbs} />
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="prose">
        <slot />
        <p class="prose__updated">Last updated {updated}</p>
      </div>
    </div>
  </section>
</SiteLayout>
