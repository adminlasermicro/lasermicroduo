---
// Inner-page heading: breadcrumb, H1 and an optional lead line.
const { title, lead, crumbs = [] } = Astro.props;
---
<header class="page-head">
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>{crumbs.map((c) => <> / {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</>)}
      </nav>
    )}
    <h1 class="h1">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</header>
