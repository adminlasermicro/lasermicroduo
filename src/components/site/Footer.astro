---
import { SITE, textHref } from '../../site.config.js';
import { PHOTOS } from '../../data/photos.js';
import Icon from './Icon.astro';
const { bare = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    {!bare && (
    <div class="footer__top">
      <div class="footer__brand">
        <a class="logo logo--light" href="/" aria-label="Laser Micro Duo home">
          <img class="logo__img" src="/brand/lmd-logo-horizontal-on-dark.svg" alt="" width="386" height="56" loading="lazy" />
        </a>
        <p>An independent authorized LaserTouchOne reseller in Arizona. Real people, real support.</p>
        <p class="footer__hours">{SITE.replyHours}</p>
        <div class="footer__contact">
          {SITE.textNumber && <a href={textHref}><Icon name="message" size={18} /> Text {SITE.textNumber}</a>}
          <a href={`mailto:${SITE.contactEmail}`}><Icon name="mail" size={18} /> {SITE.contactEmail}</a>
        </div>
      </div>
      <nav class="footer__col" aria-label="Shop">
        <p class="footer__h">Shop</p>
        <a href="/shop">LaserTouchOne kits</a>
        <button type="button" data-open-cart>Cart</button>
      </nav>
      <nav class="footer__col" aria-label="Learn">
        <p class="footer__h">Learn</p>
        <a href="/how-it-works">How it works</a>
        <a href="/faq">FAQ</a>
        <a href="/fda-clearance">FDA clearance (K100116)</a>
      </nav>
      <nav class="footer__col" aria-label="Company">
        <p class="footer__h">Company</p>
        <a href="/about">About us</a>
        <a href="/contact">Contact</a>
      </nav>
      <nav class="footer__col" aria-label="Policies">
        <p class="footer__h">Policies</p>
        <a href="/shipping">Shipping</a>
        <a href="/returns">Returns and guarantee</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
    </div>
    )}
    <p class="footer__legal">
      LaserTouchOne is FDA-cleared for over-the-counter use (510(k) K100116) for symptomatic relief of
      chronic, intractable pain, adjunctive treatment of post-surgical and post-traumatic acute pain, and
      adjunctive use in providing temporary relief of minor chronic neck and shoulder pain of musculoskeletal
      origin. LaserTouchOne is made by Laser Health Technologies LLC, Scottsdale, Arizona. Laser Micro Duo
      (Pinestone Investments LLC) is an independent authorized reseller; LaserTouchOne is a trademark of its owner.
      This site does not give medical advice. Read the user manual and talk to your doctor about your pain.
    </p>
    <div class="footer__bottom">
      <p>© {year} {SITE.legalName} · <span class="footer__secure"><Icon name="lock" size={16} /> Secure checkout by Wix</span></p>
      {Object.keys(PHOTOS).length > 0 && <p class="footer__credits">Photos: {Object.values(PHOTOS).map((p, i) => <>{i > 0 && '; '}<a href={p.page} target="_blank" rel="noopener">{p.credit}</a></>)}</p>}
    </div>
  </div>
</footer>
