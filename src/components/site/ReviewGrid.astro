---
import Icon from './Icon.astro';
import { REAL_REVIEWS } from '../../data/reviews.js';
const { limit } = Astro.props;
const list = limit ? REAL_REVIEWS.slice(0, limit) : REAL_REVIEWS;
---
<div class="reviews">
  {list.map((r) => (
    <figure class={`review ${r.placeholder ? 'review--placeholder' : ''}`}>
      <div class="stars" role="img" aria-label={`${r.stars} out of 5 stars`}>
        {Array.from({ length: 5 }, (_, i) => <Icon name="star" size={18} class={i < r.stars ? 'on' : 'off'} />)}
      </div>
      <blockquote><p>{r.text}</p></blockquote>
      <figcaption><strong>{r.name}</strong><span>{r.detail}</span></figcaption>
    </figure>
  ))}
</div>
