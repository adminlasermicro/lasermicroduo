---
// The money-back guarantee, in plain words, with the return steps. Used on Home, /lp and /shop.
import { SITE, textHref, guaranteeName } from '../../site.config.js';
const { headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}`;
const days = SITE.guaranteeDays;
---
<div class="guarantee">
  <H class="h2">Money-back guarantee, backed by the manufacturer</H>
  <p class="measure">
    Every LaserTouchOne kit is covered by {SITE.manufacturer}’ {guaranteeName}{days ? `: ${days} days from delivery` : ''}.
    If it isn’t right for you, you get a full refund of the device price. You pay the return shipping, and the
    original shipping isn’t refunded.
  </p>
  <ol class="guarantee__steps">
    <li>{SITE.textNumber ? <>Text <a href={textHref}>{SITE.textNumber}</a> or email us</> : <>Email us</>} with your order number.</li>
    <li>We send you the return instructions.</li>
    <li>Ship the full kit back, with tracking.</li>
    <li>We refund the device price to your original payment method.</li>
  </ol>
  <p><a href="/returns">Read the full returns and guarantee policy</a></p>
</div>
