---
// One of the real product photos (src/data/productPhotos.js) in a white square frame, with the
// smaller copies for phones. Usage: <ProductPhoto file="08_case-with-device.jpg" />
import { PRODUCT_PHOTOS } from '../../data/productPhotos.js';
const { file, sizes = '(max-width: 900px) calc(100vw - 40px), 560px', class: cls = '', eager = false } = Astro.props;
const p = PRODUCT_PHOTOS.find((x) => x.file === file) ?? PRODUCT_PHOTOS[0];
---
<div class={`photo-frame ${cls}`}>
  <img src={p.src} srcset={p.srcset} sizes={sizes} alt={p.alt} width="2048" height="2048" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
</div>
