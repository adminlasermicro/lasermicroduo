---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Icon from '../components/site/Icon.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { STORY } from '../data/about.js';
import { SITE } from '../site.config.js';

const promises = [
  { icon: 'calendar', text: 'Money-back guarantee (you cover return shipping)' },
  { icon: 'file', text: 'The manufacturer’s warranty card in every kit' },
  { icon: 'message', text: 'A real person answers your texts, Monday to Friday, 9am to 5pm Arizona time' },
  { icon: 'shield', text: 'Honest information: we only describe what the device is FDA-cleared for' },
];
---
<SiteLayout>
  <PageHero
    title="A family business, with real people on the other end"
    lead={`Laser Micro Duo is run by ${SITE.owner} and her family in ${SITE.ownerPlace}. We’re an authorized reseller of the LaserTouchOne, made by ${SITE.manufacturer} in Scottsdale, AZ.`}
  />

  {/* Hidden until Vicki's story is added to src/data/about.js (with her photo). */}
  {STORY.length > 0 && (
  <section class="section section--tight-top">
    <div class="container split">
      <div class="product-stage" data-photo-slot="vicki">
        <span class="product-stage__note">Photo of {SITE.owner} coming soon</span>
      </div>
      <div class="split__copy">
        <h2 class="h2">Hi, I’m {SITE.owner}</h2>
        {STORY.map((para) => <p class="story">{para}</p>)}
      </div>
    </div>
  </section>
  )}

  <section class="section band">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="h2">Our promise</h2>
      </div>
      <div class="promises promises--4">
        {promises.map((p) => (
          <div class="promise">
            <span class="icon-badge icon-badge--lg"><Icon name={p.icon} size={24} /></span>
            <p class="promise__text">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight-top">
    <div class="container buy-end">
      <a class="btn btn--primary btn--lg" href="/shop">Shop the LaserTouchOne</a>
    </div>
  </section>

  <CtaBand title="Questions before you buy?" text="Text or email us. A real person answers, Monday to Friday, 9am to 5pm Arizona time." hours={false} />
</SiteLayout>
