---
// About: Vicki Oei, Arizona; why we sell LaserTouchOne; the manufacturer. Never invent details:
// her story comes only from src/data/about.js, in her words.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHead from '../components/site/PageHead.astro';
import Media from '../components/site/Media.astro';
import CtaFinal from '../components/site/CtaFinal.astro';
import { MEDIA } from '../data/media.js';
import { STORY } from '../data/about.js';
import { SITE } from '../site.config.js';
import { breadcrumbSchema } from '../lib/schema.js';
import { loadStore } from '../lib/kits.js';
const { kit } = await loadStore();
---
<SiteLayout schema={[breadcrumbSchema([{ name: 'About', path: '/about' }])]}>
  <PageHead title={`About ${SITE.name}`} lead={`A small ${SITE.ownerPlace} business owned by ${SITE.owner}, and an independent authorized reseller of LaserTouchOne.`} crumbs={[{ label: 'About' }]} />
  <section class="section" style="padding-top:0">
    <div class="container owner" style="grid-template-columns:320px 1fr">
      <Media item={MEDIA.vicki} />
      <div class="prose">
        <h2>Meet {SITE.owner}</h2>
        {STORY.length > 0
          ? STORY.map((p) => <p>{p}</p>)
          : <p class="muted">[NEEDS NOA: Vicki’s story, in her words and with her OK: why she sells LaserTouchOne and what customers can expect from her]</p>}
      </div>
    </div>
  </section>
  <section class="section section--mist">
    <div class="container split split--top">
      <div class="prose">
        <h2>Who makes LaserTouchOne</h2>
        <p>LaserTouchOne is designed and made by {SITE.manufacturer} LLC in {SITE.manufacturerPlace}. It is FDA-cleared for over-the-counter use under 510(k) K100116. <a href="/fda-clearance">See the clearance</a>.</p>
        <p>{SITE.name} is the trading name of {SITE.legalName}. We’re an independent authorized reseller, so every device we sell is genuine and comes with the manufacturer’s warranty and money-back guarantee.</p>
      </div>
      <div class="prose">
        <h2>What you can expect from us</h2>
        <ul>
          <li>Answers before you buy, from a real person by text or email.</li>
          <li>Help with your first session, and with returns or warranty claims if you need them.</li>
          <li>{SITE.replyHours}</li>
        </ul>
      </div>
    </div>
  </section>
  <CtaFinal kit={kit} />
</SiteLayout>
