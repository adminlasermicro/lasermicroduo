---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHead from '../components/site/PageHead.astro';
import FaqList from '../components/site/FaqList.astro';
import CtaFinal from '../components/site/CtaFinal.astro';
import { FAQ_GROUPS, ALL_FAQS, faqSchema } from '../data/faq.js';
import { breadcrumbSchema } from '../lib/schema.js';
import { loadStore } from '../lib/kits.js';
const { kit } = await loadStore();
const slug = (t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<SiteLayout schema={[faqSchema(ALL_FAQS), breadcrumbSchema([{ name: 'FAQ', path: '/faq' }])]}>
  <PageHead title="Questions and answers" lead="What people ask us before and after they buy. Can’t find yours? Text or email us." crumbs={[{ label: 'FAQ' }]} />
  <section class="section" style="padding-top:0">
    <div class="container faq-wrap stack-lg">
      {FAQ_GROUPS.map((g) => (
        <section class="stack" aria-labelledby={`h-${slug(g.title)}`}>
          <h2 class="h2" id={`h-${slug(g.title)}`}>{g.title}</h2>
          <FaqList items={g.items} />
        </section>
      ))}
    </div>
  </section>
  <CtaFinal kit={kit} title="Still have a question?" text="Text or email us. A real person will answer." />
</SiteLayout>
