---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHead from '../components/site/PageHead.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import FirstSession from '../components/sections/FirstSession.astro';
import DemoVideo from '../components/sections/DemoVideo.astro';
import StudyList from '../components/site/StudyList.astro';
import CtaFinal from '../components/site/CtaFinal.astro';
import Media from '../components/site/Media.astro';
import { MEDIA } from '../data/media.js';
import { breadcrumbSchema } from '../lib/schema.js';
import { loadStore } from '../lib/kits.js';
const { kit } = await loadStore();
---
<SiteLayout schema={[breadcrumbSchema([{ name: 'How it works', path: '/how-it-works' }])]}>
  <PageHead title="How LaserTouchOne works" lead="A low-level laser and TENS electrical stimulation in one small head, about two minutes per area." crumbs={[{ label: 'How it works' }]} />
  <section class="section" style="padding-top:0">
    <div class="container split">
      <div class="stack">
        <h2 class="h2">Two technologies, one spot</h2>
        <p class="measure">In the center of the head is a single 670 nm red laser diode under 1 mW. It’s often called a cold laser because it doesn’t heat the skin. On each side is a stainless steel contact that delivers mild, pulsed TENS electrical stimulation through a thin layer of gel. Both work on the same area at the same time, and there’s one on/off button.</p>
      </div>
      <Media item={MEDIA.head} />
    </div>
  </section>
  <HowItWorks compact />
  <DemoVideo />
  <FirstSession />
  <section class="section section--mist" aria-labelledby="safety-title">
    <div class="container faq-wrap stack-lg">
      <h2 class="h2" id="safety-title">Use it safely</h2>
      <ul class="feature-list">
        <li><p>Never point the laser at your eyes or anyone else’s.</p></li>
        <li><p>If you are pregnant, or have a heart condition or epilepsy, talk to your doctor first.</p></li>
        <li><p>If your pain is new, severe or unexplained, see a doctor before using any device.</p></li>
        <li><p>Read the user manual before your first session. [NEEDS NOA: full warnings from the user manual]</p></li>
      </ul>
    </div>
  </section>
  <StudyList />
  <CtaFinal kit={kit} />
</SiteLayout>
