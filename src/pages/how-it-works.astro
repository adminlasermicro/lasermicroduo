---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Icon from '../components/site/Icon.astro';
import ProductPhoto from '../components/site/ProductPhoto.astro';
import StudyList from '../components/site/StudyList.astro';
import { STEPS, CLEARED_FOR, FDA_PDF } from '../data/shared.js';
import { SITE, textHref } from '../site.config.js';
import { loadStore } from '../lib/kits.js';

const { kit } = await loadStore();
const routine = STEPS;
const fmt = (n) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
const priceNow = Number.isFinite(kit.amount) ? fmt(kit.amount) : kit.price;
---
<SiteLayout>
  <PageHero
    title="How LaserTouchOne works"
    lead="Two gentle technologies in one small head, working on the same spot at the same time."
  />

  <section class="section section--tight-top">
    <div class="container split">
      <div class="diagram-card">
        <svg viewBox="0 0 400 300" role="img" aria-labelledby="dia-t dia-d">
          <title id="dia-t">The LaserTouchOne treatment head</title>
          <desc id="dia-d">A red laser point in the middle of the head, with a steel electrical stimulation contact on each side.</desc>
          <rect x="70" y="95" width="260" height="110" rx="55" fill="#e3eadf" />
          <circle cx="130" cy="150" r="26" fill="#9aa59f" />
          <circle cx="270" cy="150" r="26" fill="#9aa59f" />
          <circle cx="200" cy="150" r="20" fill="#c4122f" />
          <circle cx="200" cy="150" r="34" fill="none" stroke="#c4122f" stroke-opacity="0.25" stroke-width="8" />
          <line x1="200" y1="114" x2="200" y2="60" stroke="#5b6660" stroke-width="1.5" />
          <text x="200" y="48" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="15" font-weight="600" fill="#1f2b26">670 nm low-level laser</text>
          <line x1="130" y1="178" x2="130" y2="240" stroke="#5b6660" stroke-width="1.5" />
          <line x1="270" y1="178" x2="270" y2="240" stroke="#5b6660" stroke-width="1.5" />
          <text x="200" y="262" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="15" font-weight="600" fill="#1f2b26">Two steel contacts</text>
          <line x1="130" y1="240" x2="270" y2="240" stroke="#5b6660" stroke-width="1.5" />
        </svg>
      </div>
      <div class="split__copy">
        <div class="feature">
          <span class="icon-badge icon-badge--lg"><Icon name="sun" size={24} /></span>
          <div>
            <h2 class="h3">The cold laser</h2>
            <p>A single low-power red laser (670 nm, 1 mW) sits in the center of the tip. It doesn’t heat your skin, and you won’t feel it.</p>
          </div>
        </div>
        <div class="feature">
          <span class="icon-badge icon-badge--lg"><Icon name="zap" size={24} /></span>
          <div>
            <h2 class="h3">Gentle electrical stimulation</h2>
            <p>Two steel contacts beside the laser deliver mild electrical stimulation. You’ll feel a soft tingle, and a dial lets you set the strength. A thin layer of gel carries it to your skin.</p>
          </div>
        </div>
        <div class="feature">
          <span class="icon-badge icon-badge--lg"><Icon name="check" size={24} /></span>
          <div>
            <h2 class="h3">Why both in one device</h2>
            <p>Most at-home options use one technology. LaserTouchOne puts both in one handheld, so there are no sticky pads, no wires and no second device.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="h2">Using it</h2>
      </div>
      <ol class="routine">
        {routine.map((s, i) => (
          <li class="routine__step">
            <span class="step__icon"><Icon name={s.icon} size={28} /><span class="step__num" aria-hidden="true">{i + 1}</span></span>
            <div>
              <h3 class="h3">{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="split__copy">
        <h2 class="h2">What it’s cleared for</h2>
        <ul class="checklist checklist--lg">
          {CLEARED_FOR.map((c) => <li><Icon name="check" size={20} />{c}</li>)}
        </ul>
        <a class="link-arrow" href={FDA_PDF} target="_blank" rel="noopener">Read the FDA document <Icon name="arrow" size={18} /></a>
      </div>
      <ProductPhoto file="04_tip-front.jpg" />
    </div>
  </section>

  <StudyList tight />

  <section class="section section--tight-top">
    <div class="container">
      <div class="safety">
        <span class="icon-badge icon-badge--lg"><Icon name="shield" size={24} /></span>
        <div>
          <h2 class="h3">Before you start</h2>
          <p class="safety__text">Read the safety information in your user manual. Questions? Text us at <a href={textHref}>{SITE.textNumber}</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight-top">
    <div class="container buy-end">
      {kit.productId
        ? <button type="button" class="btn btn--primary btn--lg" data-add-to-cart={kit.productId} data-variant={kit.variantId ?? ''} data-track-price={kit.amount}>Add to cart{priceNow ? ` – ${priceNow}` : ''}</button>
        : <a class="btn btn--primary btn--lg" href="/shop">See the kit</a>}
      <p class="offer__fact">
        <Icon name="shield" size={18} /> Money-back guarantee ·{' '}
        {SITE.textNumber ? <>Text a real person: <a href={textHref}>{SITE.textNumber}</a></> : 'Text a real person'}
      </p>
    </div>
  </section>
</SiteLayout>
