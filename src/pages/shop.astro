---
// Product page: gallery, buy box (quantity, gel add-on, trust lines), Device facts specs and accordions.
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadStore } from '../lib/kits.js';
import { productSchema, breadcrumbSchema } from '../lib/schema.js';
import { MEDIA } from '../data/media.js';
import Media from '../components/site/Media.astro';
import PriceTag from '../components/site/PriceTag.astro';
import Assure from '../components/site/Assure.astro';
import DeviceFacts from '../components/site/DeviceFacts.astro';
import FaqList from '../components/site/FaqList.astro';
import GuaranteeBlock from '../components/site/GuaranteeBlock.astro';
import Voices from '../components/site/Voices.astro';
import StudyList from '../components/site/StudyList.astro';
import CtaFinal from '../components/site/CtaFinal.astro';
import StickyBuy from '../components/site/StickyBuy.astro';
import { INDICATION, SITE } from '../site.config.js';

const { kit, accessories } = await loadStore();
const gel = accessories.find((a) => a.key === 'gel-pack');

const gallery = [
  { key: 'cutout', label: 'Device' },
  { key: 'head', label: 'Head' },
  { key: 'inHand', label: 'In hand' },
  { key: 'inUse', label: 'In use' },
  { key: 'kit', label: 'Kit' },
  { key: 'case', label: 'Case' },
  { key: 'demo', label: 'Video' },
];

const specs = [
  { label: 'Technology', value: '670 nm low-level laser and TENS electrical stimulation, in one head' },
  { label: 'Laser', value: 'Under 1 mW. [NEEDS NOA: laser class, from the user manual]' },
  { label: 'Session', value: 'About 2 minutes per area, up to 5 times a day per area' },
  { label: 'Power', value: 'Built-in rechargeable battery, charger included. [NEEDS NOA: battery life and charge time]' },
  { label: 'FDA', value: 'Cleared for over-the-counter use, 510(k) K100116' },
  { label: 'Made by', value: `${SITE.manufacturer} LLC, Scottsdale, AZ` },
];

const details = [
  { q: 'How to use it', a: 'Apply a little electrode gel to the skin over the area. Switch the device on and move the head in slow circles over the area for about two minutes. Repeat up to five times a day per area, as the user manual describes. Wipe the gel off the head and your skin afterwards.' },
  { q: 'Safety and who shouldn’t use it', a: 'Never point the laser at your eyes or anyone else’s. If you are pregnant, or have a heart condition or epilepsy, talk to your doctor before using it. If your pain is new, severe or unexplained, see a doctor before using any device. Read the user manual before your first session. [NEEDS NOA: full warnings from the user manual]' },
  { q: 'FDA clearance', a: `LaserTouchOne is cleared for over-the-counter use under 510(k) K100116 (April 15, 2010). The cleared indication: “${INDICATION}” <a href="/fda-clearance">More about the clearance</a>.` },
  { q: 'Shipping', a: 'Flat-rate shipping within the US, shown at checkout, with tracking by text or email. International shipping is calculated at checkout. [NEEDS NOA: typical delivery time] <a href="/shipping">Shipping policy</a>.' },
  { q: 'Guarantee and returns', a: 'Covered by the manufacturer’s money-back guarantee: a full refund of the device price if it isn’t right for you. You pay the return shipping, and the original shipping isn’t refunded. <a href="/returns">How returns work</a>.' },
  { q: 'Warranty', a: `Your device comes with the warranty from ${SITE.manufacturer}. We’ll help you with any claim. [NEEDS NOA: warranty length and what it covers]` },
];
---
<SiteLayout schema={[productSchema(kit), breadcrumbSchema([{ name: 'Shop', path: '/shop' }])]}>
  <section class="product">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Shop</span></nav>
      <div class="product__grid">
        <div class="gallery" data-gallery>
          {gallery.map((g, i) => (
            <div class="gallery__panel" id={`panel-${g.key}`} hidden={i > 0}><Media item={MEDIA[g.key]} eager={i === 0} /></div>
          ))}
          <div class="gallery__thumbs" role="group" aria-label="Product photos">
            {gallery.map((g, i) => (
              <button type="button" class="gallery__thumb" aria-controls={`panel-${g.key}`} aria-pressed={i === 0 ? 'true' : 'false'}>{g.label}</button>
            ))}
          </div>
        </div>

        <span hidden data-view-content data-id={kit.productId} data-price={kit.amount}></span>
  <div class="buybox">
          <h1 class="h1">LaserTouchOne kit</h1>
          <p>A handheld, FDA-cleared, drug-free device with a low-level laser and TENS electrical stimulation in one head. For temporary relief of minor chronic neck and shoulder pain, at home.</p>
          {kit.price && <PriceTag kit={kit} />}

          <div class="stack">
            <h2 class="h4">What’s included</h2>
            <ul class="assure">
              {kit.includes.map((item) => <li><svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>{item}</span></li>)}
            </ul>
          </div>

          {gel && (
            <fieldset class="options">
              <legend>Choose your kit</legend>
              <label class="option"><input type="radio" name="bundle" value="" checked /><span>Device kit</span><span class="option__price">{kit.price?.replace('.00', '')}</span></label>
              <label class="option"><input type="radio" name="bundle" value={gel.productId} data-variant={gel.variantId ?? ''} /><span>Device kit + gel 3-pack</span><span class="option__price">+ {gel.price?.replace('.00', '')}</span></label>
            </fieldset>
          )}

          <div class="qty-field">
            <label for="qty">Quantity</label>
            <select id="qty" name="qty">{[1, 2, 3, 4, 5].map((n) => <option value={n}>{n}</option>)}</select>
          </div>

          <div data-buy-anchor>
            {kit.productId
              ? <button type="button" class="btn btn--primary btn--full" data-add-to-cart={kit.productId} data-track-price={kit.amount} data-variant={kit.variantId ?? ''} data-quantity-from="#qty" data-addon-from={gel ? 'input[name=bundle]:checked' : undefined}>Add to cart</button>
              : <a class="btn btn--primary btn--full" href="/contact">Ask about price</a>}
          </div>
          <p class="small muted">Shipping and tax calculated at checkout. Secure checkout by Wix.</p>
          <Assure />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container split split--top">
      <DeviceFacts id="specs" title="Device facts" rows={specs} />
      <div class="stack-lg">
        <h2 class="h2">Product details</h2>
        <FaqList items={details} />
      </div>
    </div>
  </section>

  {accessories.length > 0 && (
    <section class="section" id="accessories" aria-labelledby="acc-title">
      <div class="container">
        <div class="section-head"><h2 class="h2" id="acc-title">Gel refills</h2></div>
        <div class="split split--top">
          {accessories.map((a) => (
            <div class="stack">
              <h3 class="h3">{a.name}</h3>
              <p>{a.text}</p>
              <p class="h4">{a.price?.replace('.00', '')}</p>
              <button type="button" class="btn btn--secondary" data-add-to-cart={a.productId} data-variant={a.variantId ?? ''}>Add {a.name.toLowerCase()} to cart</button>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <Voices />
  <StudyList limit={2} />
  <section class="section"><div class="container"><GuaranteeBlock /></div></section>
  <CtaFinal kit={kit} title="Questions before you buy?" text="Text us and a real person will help you decide whether LaserTouchOne is right for you." />
  <StickyBuy kit={kit} />

  <script>
    document.querySelectorAll('[data-gallery]').forEach((g) => {
      const thumbs = g.querySelectorAll('.gallery__thumb');
      thumbs.forEach((t) => t.addEventListener('click', () => {
        thumbs.forEach((x) => {
          const on = x === t;
          x.setAttribute('aria-pressed', String(on));
          const panel = document.getElementById(x.getAttribute('aria-controls'));
          if (panel) panel.hidden = !on;
        });
      }));
    });
  </script>
</SiteLayout>
