---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/site/Icon.astro';
import ReviewGrid from '../components/site/ReviewGrid.astro';
import { REAL_REVIEWS } from '../data/reviews.js';
import FaqList from '../components/site/FaqList.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { loadStore } from '../lib/kits.js';
import PriceTag from '../components/site/PriceTag.astro';
import StickyBuy from '../components/site/StickyBuy.astro';
import ResellerSeal from '../components/site/ResellerSeal.astro';
import StudyList from '../components/site/StudyList.astro';
import { SITE, textHref } from '../site.config.js';

const { kit, accessories } = await loadStore();
const details = [
  { q: 'What’s in the box', a: `${kit.includes.join(', ')}.` },
  { q: 'How to use it', a: 'Apply a little electrode gel to the sore spot, switch the device on and move the head in slow circles or paint strokes over the area for two minutes. Repeat up to five times a day on each area.' },
  { q: 'Safety', a: 'Never point the laser at your eyes or anyone else’s. If you are pregnant, or have a heart condition or epilepsy, talk to your doctor before using it. Read the user manual before your first session.' },
  { q: 'Shipping and returns', a: 'Flat-rate shipping within the US, and international shipping calculated at checkout, with tracking by text or email. Every kit has a 30-day in-home trial: if it isn’t right for you, contact us within 30 days and we’ll help you return it.' },
  { q: 'Warranty', a: 'As an authorized reseller, we sell genuine devices that come with the full manufacturer’s warranty. We’ll help you with any claim.' },
  { q: 'FDA clearance', a: 'LaserTouchOne is FDA-cleared for over-the-counter use (510(k) K100116) for symptomatic relief of chronic, intractable pain, adjunctive treatment of post-surgical and post-traumatic acute pain, and temporary relief of minor chronic neck and shoulder pain.' },
];
---
<SiteLayout
  title="Shop the LaserTouchOne kit | Laser Micro Duo"
  description="Buy the LaserTouchOne kit with the carrying case included. FDA-cleared, drug-free pain relief at home, with flat-rate US shipping and a 30-day in-home trial."
>
  <section class="product">
    <div class="container product__grid">
      <div class="gallery" data-gallery>
        <div class="gallery__main" data-photo-slot="product-main">
          <span class="product-stage__note">Product photo coming soon</span>
        </div>
        <div class="gallery__thumbs">
          {['Device', 'Treatment head', 'Kit contents', 'In use'].map((t, i) => (
            <button type="button" class={`gallery__thumb ${i === 0 ? 'is-active' : ''}`} aria-label={`Show photo: ${t}`} data-photo-slot={`product-thumb-${i + 1}`}><span>{t}</span></button>
          ))}
        </div>
      </div>

      <div class="buybox" data-buybox>
        <h1 class="h2 buybox__title">LaserTouchOne</h1>
        <p class="lead">Cold laser and microcurrent in one handheld, FDA-cleared device. Drug-free relief, two minutes at a time. Sold and supported by Laser Micro Duo, an authorized reseller.</p>

        <ul class="checklist buybox__includes">
          {kit.includes.map((item) => <li><Icon name="check" size={18} />{item}</li>)}
        </ul>

        <div class="buybox__price-row">
          {kit.price ? <PriceTag kit={kit} /> : <p class="buybox__price">Price on request</p>}
          <p class="buybox__hsa">Shipping and tax calculated at checkout</p>
        </div>

        {kit.productId
          ? <button type="button" class="btn btn--primary btn--lg btn--full" data-buy-anchor data-add-to-cart={kit.productId} data-variant={kit.variantId ?? ''}>Add to cart</button>
          : <a class="btn btn--primary btn--lg btn--full" href="/contact">Ask about price</a>}

        <ul class="buybox__perks">
          <li><Icon name="truck" size={20} /> Flat-rate US shipping</li>
          <li><Icon name="calendar" size={20} /> 30-day in-home trial</li>
          <li><Icon name="shield" size={20} /> Manufacturer’s warranty</li>
        </ul>

        <div class="seals"><ResellerSeal /><ResellerSeal kind="fda" /></div>

        {SITE.textNumber && (
          <a class="buybox__help" href={textHref}>
            <span class="icon-badge"><Icon name="message" /></span>
            <span><strong>Questions before you buy?</strong><br />Text us at {SITE.textNumber}. A real person replies.</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="section section--tight-top">
    <div class="container product-details">
      <div class="section-head">
        <h2 class="h2">Product details</h2>
        <p class="lead">Everything you need to know before your first session.</p>
      </div>
      <FaqList items={details} />
    </div>
  </section>

  <StudyList limit={2} tight title="What the research says" />

  {REAL_REVIEWS.length > 0 && (
  <section class="section section--tint" id="reviews">
    <div class="container">
      <div class="section-head">
        <h2 class="h2">Customer reviews</h2>
        <p class="lead">From people who use LaserTouchOne in their everyday lives.</p>
      </div>
      <ReviewGrid />
    </div>
  </section>
  )}

  {accessories.length > 0 && (
    <section class="section" id="accessories">
      <div class="container">
        <div class="section-head">
          <h2 class="h2">Gel and accessories</h2>
          <p class="lead">Keep your routine going with refills and spares.</p>
        </div>
        <div class="accessories">
          {accessories.map((a) => (
            <article class="accessory">
              <div class="accessory__media" data-photo-slot={`accessory-${a.key}`}><span>Photo coming soon</span></div>
              <div class="accessory__body">
                <h3 class="h3">{a.name}</h3>
                <p>{a.text}</p>
                <div class="accessory__foot">
                  <span class="accessory__price">{a.price}</span>
                  <button type="button" class="btn btn--primary btn--sm" data-add-to-cart={a.productId} data-variant={a.variantId ?? ''}>Add to cart</button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand title="Still deciding?" />
  <StickyBuy kit={kit} />

  <script>
    document.querySelectorAll('[data-gallery] .gallery__thumb').forEach((t, _, all) => t.addEventListener('click', () => {
      all.forEach((x) => x.classList.toggle('is-active', x === t));
    }));
  </script>
</SiteLayout>
