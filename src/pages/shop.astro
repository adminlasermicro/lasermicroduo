---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/site/Icon.astro';
import ReviewGrid from '../components/site/ReviewGrid.astro';
import { REAL_REVIEWS } from '../data/reviews.js';
import FaqList from '../components/site/FaqList.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { loadStore } from '../lib/kits.js';
import StickyBuy from '../components/site/StickyBuy.astro';
import ResellerSeal from '../components/site/ResellerSeal.astro';
import StudyList from '../components/site/StudyList.astro';
import { SITE, textHref } from '../site.config.js';
import { productSchema, breadcrumbSchema } from '../lib/schema.js';
import { PRODUCT_PHOTOS, GALLERY_SIZES } from '../data/productPhotos.js';

const { kit, accessories } = await loadStore();
const FDA_PDF = 'https://www.accessdata.fda.gov/cdrh_docs/pdf10/K100116.pdf';
const fmt = (n) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
const priceNow = Number.isFinite(kit.amount) ? fmt(kit.amount) : kit.price;
const priceWas = kit.compareAt && Number.isFinite(kit.compareAmount) ? fmt(kit.compareAmount) : null;
const saving = priceWas && kit.compareAmount > kit.amount ? fmt(kit.compareAmount - kit.amount) : null;
const specs = [
  { label: 'Laser', value: '670 nm red light, 1 mW (low-level, no heat)' },
  { label: 'Electrical stimulation', value: 'Two steel contacts, strength set by a dial' },
  { label: 'Session', value: 'About 2 minutes per area, up to 5 times a day, 2–3 hours apart' },
  { label: 'Charging', value: '5–7 hours for a full charge, usually lasts 2–3 weeks' },
  { label: 'FDA', value: '510(k) K100116, Class II, over-the-counter' },
  { label: 'Made by', value: `${SITE.manufacturer}, Scottsdale, AZ` },
];
const details = [
  { q: 'How to use', a: 'Add a thin layer of gel. Glide the tip in small, slow circles over your neck or shoulder for about 2 minutes. Repeat up to 5 times a day, 2–3 hours apart.' },
  { q: 'Safety', a: `Read the safety information in your user manual before first use. Questions? Text us at <a href="${textHref}">${SITE.textNumber}</a>.` },
  { q: 'FDA clearance', a: `Cleared April 15, 2010 for over-the-counter use. <a href="${FDA_PDF}" target="_blank" rel="noopener">Read the FDA document</a>` },
  { q: 'Shipping', a: 'Flat-rate shipping within the US, and international shipping calculated at checkout, with tracking by text or email.' },
  { q: 'Guarantee & returns', a: 'If LaserTouchOne isn’t right for you, send it back for a refund of the device price. You cover return shipping. <a href="/returns">Read the full guarantee</a>' },
  { q: 'Warranty', a: 'Includes the manufacturer’s warranty card. Details are in your user manual.' },
];
---
<SiteLayout preloadImage={{ src: PRODUCT_PHOTOS[0].src, srcset: PRODUCT_PHOTOS[0].srcset, sizes: GALLERY_SIZES }} schema={[productSchema(kit), breadcrumbSchema([{ name: 'Shop', path: '/shop' }])]}>
  <section class="product">
    <div class="container product__grid">
      <div class="gallery" data-gallery>
        <div class="gallery__main gallery__main--photo">
          <img class="gallery__img" data-gallery-main src={PRODUCT_PHOTOS[0].src} srcset={PRODUCT_PHOTOS[0].srcset} sizes={GALLERY_SIZES} alt={PRODUCT_PHOTOS[0].alt} width="2048" height="2048" fetchpriority="high" />
        </div>
        <div class="gallery__thumbs gallery__thumbs--photos" role="group" aria-label="Product photos">
          {PRODUCT_PHOTOS.map((p, i) => (
            <button type="button" class={`gallery__thumb gallery__thumb--photo ${i === 0 ? 'is-active' : ''}`} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Photo ${i + 1} of ${PRODUCT_PHOTOS.length}: ${p.alt}`} data-src={p.src} data-srcset={p.srcset} data-alt={p.alt}>
              <img src={p.thumb} alt="" width="200" height="200" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>

      <span hidden data-view-content data-id={kit.productId} data-price={kit.amount}></span>
      <div class="buybox" data-buybox>
        <h1 class="h2 buybox__title">LaserTouchOne Deluxe Travel Kit</h1>
        <div class="buybox__price-row">
          {priceNow
            ? <p class="offer__price"><strong>{priceNow}</strong>{priceWas && <> · <span>Manufacturer list price <s>{priceWas}</s></span></>}{saving && <> · <span class="offer__save">You save {saving}</span></>}</p>
            : <p class="buybox__price">Price on request</p>}
          <p class="buybox__hsa">Shipping and tax calculated at checkout</p>
        </div>
        <p class="lead">A handheld device that pairs a cold laser with gentle electrical stimulation, FDA-cleared for temporary relief of minor chronic neck and shoulder pain. Drug-free, no prescription, about 2 minutes per area.</p>

        <div class="qty-field">
          <label for="qty">Quantity</label>
          <select id="qty" name="qty">{[1, 2, 3, 4, 5].map((n) => <option value={n}>{n}</option>)}</select>
        </div>

        {kit.productId
          ? <button type="button" class="btn btn--primary btn--lg btn--full" data-buy-anchor data-add-to-cart={kit.productId} data-variant={kit.variantId ?? ''} data-quantity-from="#qty" data-track-price={kit.amount}>Add to cart{priceNow ? ` – ${priceNow}` : ''}</button>
          : <a class="btn btn--primary btn--lg btn--full" href="/contact">Ask about price</a>}

        <p class="offer__fact">
          <Icon name="shield" size={18} /> Money-back guarantee ·{' '}
          {SITE.textNumber ? <>Text a real person: <a href={textHref}>{SITE.textNumber}</a></> : 'Text a real person'}
        </p>
        {SITE.hsaFsa && <p class="offer__fact"><Icon name="wallet" size={18} /> May be HSA/FSA eligible</p>}

        <div class="buybox__included">
          <h2 class="h3">What’s included</h2>
          <ul class="checklist buybox__includes">
            {kit.includes.map((item) => <li><Icon name="check" size={18} />{item}</li>)}
          </ul>
        </div>

        <div class="seals"><ResellerSeal /><ResellerSeal kind="fda" /></div>

        {SITE.textNumber && (
          <a class="buybox__help" href={textHref}>
            <span class="icon-badge"><Icon name="message" /></span>
            <span><strong>Questions before you buy?</strong><br />Text us at {SITE.textNumber}. A real person replies.</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="section section--tight-top">
    <div class="container product-details">
      <div class="section-head">
        <h2 class="h2">Product details</h2>
        <dl class="specs" aria-label="Specifications">
          {specs.map((r) => <div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}
        </dl>
      </div>
      <FaqList items={details} openFirst={false} />
    </div>
  </section>

  <StudyList limit={2} tight title="What the research says" />

  {REAL_REVIEWS.length > 0 && (
  <section class="section section--tint" id="reviews">
    <div class="container">
      <div class="section-head">
        <h2 class="h2">Customer reviews</h2>
        <p class="lead">From people who use LaserTouchOne in their everyday lives.</p>
      </div>
      <ReviewGrid />
    </div>
  </section>
  )}

  {accessories.length > 0 && (
    <section class="section" id="accessories">
      <div class="container">
        <div class="section-head">
          <h2 class="h2">Gel and accessories</h2>
          <p class="lead">Keep your routine going with refills and spares.</p>
        </div>
        <div class="accessories">
          {accessories.map((a) => (
            <article class="accessory">
              <div class="accessory__media" data-photo-slot={`accessory-${a.key}`}><span>Photo coming soon</span></div>
              <div class="accessory__body">
                <h3 class="h3">{a.name}</h3>
                <p>{a.text}</p>
                <div class="accessory__foot">
                  <span class="accessory__price">{a.price}</span>
                  <button type="button" class="btn btn--primary btn--sm" data-add-to-cart={a.productId} data-variant={a.variantId ?? ''}>Add to cart</button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand title="Still deciding?" />
  <StickyBuy kit={kit} />

  <script>
    // Gallery: a thumbnail shows its photo in the main frame.
    document.querySelectorAll('[data-gallery]').forEach((g) => {
      const main = g.querySelector('[data-gallery-main]');
      const thumbs = g.querySelectorAll('.gallery__thumb');
      thumbs.forEach((t) => t.addEventListener('click', () => {
        if (main && t.dataset.src) { main.srcset = t.dataset.srcset || ''; main.src = t.dataset.src; main.alt = t.dataset.alt || ''; }
        thumbs.forEach((x) => { x.classList.toggle('is-active', x === t); x.setAttribute('aria-pressed', String(x === t)); });
      }));
    });
  </script>
</SiteLayout>
