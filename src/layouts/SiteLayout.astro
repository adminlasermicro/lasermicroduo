---
// Shared page shell (original Ink & Copper design). Props:
//   title, description  page SEO (defaults come from src/data/seo.js by path)
//   noindex             keep the page out of search (ad landing pages)
//   bare                ad landing page mode: logo and text-us line only, no menu
//   schema              extra JSON-LD objects for this page
//   ogImage             social preview image path
//   preloadImage        hero image to fetch first (speeds up the first screen)
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import font400 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url';
import font700 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-700-normal.woff2?url';
import '../styles/lmd-tokens.css';
import '../styles/site.css';
import '../styles/trust.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import CartBridge from '../components/CartBridge.jsx';
import { SEO } from '../data/seo.js';
import { SITE } from '../site.config.js';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const seo = SEO[path] ?? {};
const {
  title = seo.title ?? SITE.name,
  description = seo.description ?? '',
  noindex = false,
  bare = false,
  schema = [],
  ogImage = '/og/lasermicroduo-share.jpg',
  preloadImage,
} = Astro.props;

// This layout prints each page's title, description and share tags from src/data/seo.js.
// Wix would also inject its own "{page} | Laser Micro Duo" title and share tags, so on Nov 18, 2026 the
// site's STATIC_PAGE SEO pattern (Wix dashboard > SEO Settings > Main pages > Customize defaults) was set
// to disable Wix's title, og:* and twitter:* tags. Wix still adds the canonical link. Leave this false.
const wixSeo = false;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#org`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  logo: `${SITE.url}/brand/lmd-logo-horizontal.svg`,
  email: SITE.contactEmail,
  telephone: '+1-480-734-4877',
  address: { '@type': 'PostalAddress', addressRegion: 'AZ', addressCountry: 'US' },
  contactPoint: [{
    '@type': 'ContactPoint', contactType: 'customer support', telephone: '+1-480-734-4877', email: SITE.contactEmail,
    availableLanguage: 'English', hoursAvailable: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  }],
};
const ld = [org, ...schema];
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {!wixSeo && <title>{title}</title>}
    {!wixSeo && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* Share tags come before the ones Wix adds, so link previews (Facebook, X, iMessage) use the
        page's own title and description instead of Wix's "Page | Laser Micro Duo". */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path === '/' ? '/' : path, SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The LaserTouchOne handheld device" />
    <meta name="twitter:image" content={new URL(ogImage, SITE.url).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f2d5c" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font700} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src ?? preloadImage} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.srcset ? (preloadImage.sizes ?? '100vw') : undefined} fetchpriority="high" />}
    <script is:inline>document.documentElement.classList.replace("no-js", "js");</script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header bare={bare} />
    <main id="main"><slot /></main>
    <Footer bare={bare} />
    <CartBridge client:load />
    <script>import '../scripts/site.js';</script>
  </body>
</html>
